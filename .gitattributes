# ==========================================
# Default text handling
# ==========================================

* text=auto

# Platform-specific line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh  text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# ==========================================
# Unreal Engine text files
# ==========================================

*.uproject text
*.uplugin  text
*.ini      text
*.config   text
*.json     text
*.xml      text
*.csv      text
*.txt      text
*.md       text

# ==========================================
# C++ / C# / shader source
# ==========================================

*.h     text
*.hpp   text
*.c     text
*.cpp   text
*.cc    text
*.cxx   text
*.cs    text
*.csproj text

*.usf   text
*.ush   text
*.hlsl  text
*.glsl  text

# ==========================================
# Unreal Engine binary assets
# ==========================================

*.uasset binary
*.umap   binary
*.ubulk  binary
*.uexp   binary
*.uptnl  binary

